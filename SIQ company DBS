CREATE TABLE employees (
    employee_id SERIAL PRIMARY KEY,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    age INT,
    email VARCHAR(100),
    salary DECIMAL(10,2),
    department_id INT REFERENCES department(department_id)
);


